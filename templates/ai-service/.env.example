# ===== AI Service Template — 환경변수 예시 =====
#
# 이 파일을 .env.local로 복사하고 값을 채워 로컬 개발에 사용.
# 운영 배포는 Netlify 대시보드 > Site settings > Environment variables 에서 동일 키를 추가.
# .env.local은 .gitignore에 포함되어 commit 안 됨.
#
# OPENAI_API_KEY 또는 GEMINI_API_KEY 중 최소 하나는 필수.

# ---- AI provider 선택 (옵션) ----
# 둘 다 키가 있으면 명시적으로 선택. 값이 없으면 키가 있는 쪽 자동 선택(OpenAI 우선).
# AI_PROVIDER=openai
# AI_PROVIDER=gemini

# ---- OpenAI ----
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Gemini ----
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-001

# ---- 호출 제한 (옵션) ----
# IP당 시간당 최대 호출 수. 0이면 무제한(권장 안 함). 기본 20.
# 비용 폭주 1차 방어용 — 진짜 엄격한 제한은 Upstash 등 외부 stateful 저장소로.
RATE_LIMIT_PER_HOUR=20
